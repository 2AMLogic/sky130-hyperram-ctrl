{
  "backend": "batch",
  "models": { "pdk": "sky130A", "lib": "libs.tech/ngspice/sky130.lib.spice" },
  "netlist": "../sim/delay-chain/dlychain.sp",
  "engine": "ngspice",
  "analysis": { "kind": "tran", "args": "5p 30n 0 25p" },
  "corners": {
    "process": ["tt", "ff", "ss", "fs", "sf"],
    "temperature_c": [-40, 27, 125],
    "supply_v": { "vdd": [1.62, 1.80, 1.98], "vrwds": [1.62, 1.80, 1.98] },
    "supply_waveforms": ["vrwds"]
  },
  "options": { "timeout_s": 300 },
  "measurements": [
    { "name": "in_rise",  "crossings": { "signal": "v(rwds)",  "level": { "frac_of": "vdd", "fraction": 0.5 }, "edge": "rise", "from": 0, "to": "30n", "max": 4 } },
    { "name": "in_fall",  "crossings": { "signal": "v(rwds)",  "level": { "frac_of": "vdd", "fraction": 0.5 }, "edge": "fall", "from": 0, "to": "30n", "max": 4 } },
    { "name": "tap0_rise", "crossings": { "signal": "v(dly02)", "level": { "frac_of": "vdd", "fraction": 0.5 }, "edge": "rise", "from": 0, "to": "30n", "max": 4 } },
    { "name": "tap0_fall", "crossings": { "signal": "v(dly02)", "level": { "frac_of": "vdd", "fraction": 0.5 }, "edge": "fall", "from": 0, "to": "30n", "max": 4 } },
    { "name": "tap1_rise", "crossings": { "signal": "v(dly04)", "level": { "frac_of": "vdd", "fraction": 0.5 }, "edge": "rise", "from": 0, "to": "30n", "max": 4 } },
    { "name": "tap1_fall", "crossings": { "signal": "v(dly04)", "level": { "frac_of": "vdd", "fraction": 0.5 }, "edge": "fall", "from": 0, "to": "30n", "max": 4 } },
    { "name": "tap2_rise", "crossings": { "signal": "v(dly06)", "level": { "frac_of": "vdd", "fraction": 0.5 }, "edge": "rise", "from": 0, "to": "30n", "max": 4 } },
    { "name": "tap2_fall", "crossings": { "signal": "v(dly06)", "level": { "frac_of": "vdd", "fraction": 0.5 }, "edge": "fall", "from": 0, "to": "30n", "max": 4 } },
    { "name": "tap3_rise", "crossings": { "signal": "v(dly08)", "level": { "frac_of": "vdd", "fraction": 0.5 }, "edge": "rise", "from": 0, "to": "30n", "max": 4 } },
    { "name": "tap3_fall", "crossings": { "signal": "v(dly08)", "level": { "frac_of": "vdd", "fraction": 0.5 }, "edge": "fall", "from": 0, "to": "30n", "max": 4 } },
    { "name": "tap4_rise", "crossings": { "signal": "v(dly10)", "level": { "frac_of": "vdd", "fraction": 0.5 }, "edge": "rise", "from": 0, "to": "30n", "max": 4 } },
    { "name": "tap4_fall", "crossings": { "signal": "v(dly10)", "level": { "frac_of": "vdd", "fraction": 0.5 }, "edge": "fall", "from": 0, "to": "30n", "max": 4 } },
    { "name": "tap5_rise", "crossings": { "signal": "v(dly12)", "level": { "frac_of": "vdd", "fraction": 0.5 }, "edge": "rise", "from": 0, "to": "30n", "max": 4 } },
    { "name": "tap5_fall", "crossings": { "signal": "v(dly12)", "level": { "frac_of": "vdd", "fraction": 0.5 }, "edge": "fall", "from": 0, "to": "30n", "max": 4 } },
    { "name": "tap6_rise", "crossings": { "signal": "v(dly14)", "level": { "frac_of": "vdd", "fraction": 0.5 }, "edge": "rise", "from": 0, "to": "30n", "max": 4 } },
    { "name": "tap6_fall", "crossings": { "signal": "v(dly14)", "level": { "frac_of": "vdd", "fraction": 0.5 }, "edge": "fall", "from": 0, "to": "30n", "max": 4 } },
    { "name": "tap7_rise", "crossings": { "signal": "v(dly16)", "level": { "frac_of": "vdd", "fraction": 0.5 }, "edge": "rise", "from": 0, "to": "30n", "max": 4 } },
    { "name": "tap7_fall", "crossings": { "signal": "v(dly16)", "level": { "frac_of": "vdd", "fraction": 0.5 }, "edge": "fall", "from": 0, "to": "30n", "max": 4 } }
  ]
}
